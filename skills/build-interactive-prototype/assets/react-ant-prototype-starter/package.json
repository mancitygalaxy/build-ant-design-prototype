{
  "name": "react-ant-prototype-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "lint": "oxlint src",
    "check:initialized": "node scripts/check-project-initialized.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:architecture-gate": "node scripts/test-architecture-gate.mjs",
    "check:acceptance": "node scripts/check-acceptance-contract.mjs",
    "scan:sensitive": "node scripts/scan-sensitive.mjs",
    "build": "pnpm run check:initialized && pnpm run check:architecture && pnpm run check:acceptance && pnpm run lint && pnpm run typecheck && vite build --config vite.config.ts && node scripts/write-build-manifest.mjs",
    "verify:delivery": "node scripts/verify-delivery.mjs",
    "test:browser": "node scripts/browser-regression.mjs",
    "baseline:browser": "node scripts/browser-regression.mjs --update-baseline --confirm-product-change",
    "verify:release": "pnpm run test:architecture-gate && pnpm run test:quality-gates && pnpm run build && pnpm run verify:delivery && pnpm run test:browser && pnpm run check:performance && pnpm run scan:sensitive",
    "deliver": "pnpm run verify:release && node scripts/deliver.mjs && pnpm run scan:sensitive",
    "preview": "node scripts/preview-server.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "baseline:performance": "node scripts/check-performance.mjs --record-baseline",
    "test:quality-gates": "node --test scripts/quality-gates.test.mjs scripts/tooling-regressions.test.mjs scripts/browser-checks.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "antd": "6.5.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "oxlint": "1.71.0",
    "parse5": "8.0.0",
    "playwright-core": "1.61.1",
    "sass": "1.101.0",
    "typescript": "6.0.2",
    "vite": "8.1.1",
    "vite-plugin-singlefile": "2.3.3"
  },
  "packageManager": "pnpm@11.17.0"
}
